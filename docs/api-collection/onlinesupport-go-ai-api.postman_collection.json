          }
        },
        {
          "name": "inbound: line",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const secret = pm.environment.get(\"line_channel_secret\") || \"\";",
                  "const messageId = \"pm-\" + Date.now();",
                  "pm.environment.set(\"inbound_external_message_id\", messageId);",
                  "const raw = JSON.stringify({",
                  "    destination: pm.environment.get(\"line_destination_id\"),",
                  "    events: [",
                  "        {",
                  "            type: \"message\",",
                  "            timestamp: Date.now(),",
                  "            source: { type: \"user\", userId: pm.environment.get(\"line_user_id\") },",
                  "            message: { id: messageId, type: \"text\", text: pm.environment.get(\"tenant_known_issue\") },",
                  "            replyToken: \"pm-reply-token\"",
                  "        }",
                  "    ]",
                  "});",
                  "pm.variables.set(\"line_raw_body\", raw);",
                  "pm.variables.set(\"line_signature\", CryptoJS.HmacSHA256(raw, secret).toString(CryptoJS.enc.Base64));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Line-Signature", "value": "{{line_signature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{line_raw_body}}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/inbound/line",
              "host": ["{{base_url}}"],
              "path": ["v1", "inbound", "line"]
            },
            "description": "Public, signature-gated. The pre-request script signs the body with `line_channel_secret` (base64 HMAC-SHA256)."
          }
        },
        {
          "name": "inbound: email",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const secret = pm.environment.get(\"ai_webhook_secret\") || \"\";",
                  "const messageId = \"<pm-\" + Date.now() + \"@mail.local>\";",
                  "pm.environment.set(\"inbound_external_message_id\", messageId);",
                  "const raw = JSON.stringify({",
                  "    message_id: messageId,",
                  "    from: pm.environment.get(\"inbound_email_from\"),",
                  "    to: pm.environment.get(\"inbound_email_to\"),",
                  "    subject: \"Damaged packaging on my last order\",",
                  "    body: pm.environment.get(\"tenant_known_issue\"),",
                  "    body_html: \"\"",
                  "});",
                  "pm.variables.set(\"email_raw_body\", raw);",
                  "pm.variables.set(\"email_signature\", \"sha256=\" + CryptoJS.HmacSHA256(raw, secret).toString(CryptoJS.enc.Hex));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-AI-Signature", "value": "{{email_signature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{email_raw_body}}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/inbound/email",
              "host": ["{{base_url}}"],
              "path": ["v1", "inbound", "email"]
            },
            "description": "Public, signature-gated with `ai_webhook_secret` (hex HMAC-SHA256). `to` must match a `channel_accounts` row."
          }
        }
      ]
