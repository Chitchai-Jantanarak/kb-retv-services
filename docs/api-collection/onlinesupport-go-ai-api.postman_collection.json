            "url": {
              "raw": "{{base_url}}/v1/chat/confirm-action",
              "host": ["{{base_url}}"],
              "path": ["v1", "chat", "confirm-action"]
            },
            "description": "`ai:reply:create`. `action_id` is the 32-char id from a prior `chat`/`chat: stream` response's `pending_action.id`."
          }
        },
        {
