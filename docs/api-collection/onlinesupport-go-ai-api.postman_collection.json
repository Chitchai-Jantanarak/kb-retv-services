    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{service_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Go service",
      "description": "Echo v5 service in `go/`. All `/v1` responses are wrapped in `{success, data, error}`.",
      "item": [
        {
          "name": "healthz",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/healthz",
              "host": ["{{base_url}}"],
              "path": ["healthz"]
            },
            "description": "Liveness. Bare body, not the envelope."
          }
        },
        {
          "name": "swagger index",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/swagger/index.html",
              "host": ["{{base_url}}"],
              "path": ["swagger", "index.html"]
            },
            "description": "Only mounted when `SWAGGER_ENABLED=true` and `APP_ENV` is not production."
          }
        },
        {
          "name": "reply",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Timeout-Ms", "value": "{{request_timeout_ms}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"cust_10293\",\n  \"site_id\": \"site_42\",\n  \"message\": \"{{tenant_known_issue}}\",\n  \"channel\": \"web\",\n  \"conversation_id\": \"conv_8f21\",\n  \"message_id\": \"msg_1001\",\n  \"metadata\": {\n    \"source\": \"postman\"\n  },\n  \"mode\": \"full_review\",\n  \"debug\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/reply",
              "host": ["{{base_url}}"],
              "path": ["v1", "reply"]
            },
            "description": "`ai:reply:create`. `mode`: fast_draft | full_review | debug. `debug: true` adds `stage_timings_ms` and `debug_trace`."
          }
        },
        {
          "name": "chat",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Timeout-Ms", "value": "{{request_timeout_ms}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"{{chat_known_issue}}\" }\n  ],\n  \"locale\": \"en\",\n  \"debug\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/chat",
              "host": ["{{base_url}}"],
              "path": ["v1", "chat"]
            },
            "description": "`ai:reply:create`. Roles: user | assistant. Locale other than `en` becomes `th`."
          }
        },
        {
          "name": "chat: stream",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "text/event-stream" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Timeout-Ms", "value": "{{request_timeout_ms}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"{{chat_known_issue}}\" }\n  ],\n  \"locale\": \"en\",\n  \"debug\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/chat/stream",
              "host": ["{{base_url}}"],
              "path": ["v1", "chat", "stream"]
            },
            "description": "`ai:reply:create`. Same body as `chat`. Server-Sent Events: each frame is `event: <type>\\ndata: <json>`, types start | token | tool | pending_action | done | error."
          }
        },
        {
          "name": "chat: confirm action",
