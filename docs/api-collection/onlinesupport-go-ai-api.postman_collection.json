            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Timeout-Ms", "value": "{{request_timeout_ms}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"{{search_query}}\",\n  \"types\": [\"kb\"],\n  \"limit\": 10\n}",
