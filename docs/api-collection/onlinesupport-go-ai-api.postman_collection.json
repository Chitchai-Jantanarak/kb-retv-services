{
  "info": {
    "_postman_id": "b2c9e6f4-71a8-4d3e-8c05-9a1f4d7b6e22",
    "name": "onlinesupport-go-ai / api",
    "description": "Ready-to-use route list. Fire any request, read the response. No assertions.\n\nFor negative cases, timing probes and signature checks, use the `onlinesupport-go-ai / tests` collection. Both share one environment.",
