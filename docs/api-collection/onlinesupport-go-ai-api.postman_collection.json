    {
      "name": "Laravel ai",
      "description": "The `/api/ai` section behind `auth:api` + `coverage`. Passport bearer, not the service JWT — set `passport_token`.",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{passport_token}}", "type": "string" }]
      },
      "item": [
        {
          "name": "attachments: upload",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set(\"stored_media_key\", json.storage_key);",
                  "    pm.environment.set(\"attachment_signed_url\", json.url);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Max 10 MB. png, jpeg, webp, gif, audio/webm, audio/ogg, audio/mpeg, audio/wav."
                }
              ]
            },
            "url": {
              "raw": "{{laravel_base_url}}/api/ai/attachments",
              "host": ["{{laravel_base_url}}"],
              "path": ["api", "ai", "attachments"]
            },
            "description": "Stores the file under `attachments/{company_id}/{uuid}.{ext}` and returns `{id, storage_key, mime_type, size_bytes, url}`. The `url` is a 1-hour signed relative link. Captures `storage_key` into the environment so the Go reply requests can reference it."
          }
        },
