{
  "id": "f5_product_cases",
  "intent": "product_cases",
  "kind": "read",
  "description": "Cases owned by a product or model",
  "anchors": [
    "cases of product",
    "issues with model",
    "cases for this robot",
    "problems reported for this model",
    "how many tickets for this machine",
    "เคสของสินค้า",
    "ปัญหารุ่น",
    "เคสของหุ่นยนต์รุ่นนี้",
    "ปัญหาของเครื่องรุ่นนี้",
    "มีเคสของรุ่นนี้กี่เคส"
  ],
  "params": [
    {
      "name": "product",
      "required": true,
      "lookup": "nodes.title"
    }
  ],
  "resolve": [
    {
      "word": "product",
      "to": "node_id"
    }
  ],
  "defaults": {},
  "rbac": {
    "requires_permission": "report.view",
    "team_view": false
  },
  "handler": "reports.byProduct",
  "limit": 10,
  "compose": {
    "headline": "{n} cases for {product}",
    "row": "{code}|{title}|{status}",
    "cite": "code",
    "mode": "template",
    "columns": [
      {
        "key": "code",
        "type": "case_ref",
        "primary": true
      },
      {
        "key": "title",
        "type": "text"
      },
      {
        "key": "status",
        "type": "status"
      }
    ],
    "headline_i18n": {
      "en": "{n} cases for {product}",
      "th": "พบ {n} เคสสำหรับ {product}"
    }
  },
  "audit": "ai.product_cases",
  "enabled_by": "company"
}
