APP_ENV=development
SERVER_PORT=8080

MYSQL_ENABLED=false
MYSQL_DSN=user:password@tcp(localhost:3306)/dbname?parseTime=true&charset=utf8mb4,utf8
MYSQL_MAXOPENCONNS=25
MYSQL_MAXIDLECONNS=5

QDRANT_ENABLED=false
QDRANT_URL=http://localhost:6333
QDRANT_APIKEY=
QDRANT_COLLECTIONPREFIX=centric_rag
QDRANT_TENANTCOLLECTIONS=false

MEMGRAPH_ENABLED=false
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=

REDIS_URL=redis://localhost:6379

LOGGER_LEVEL=info
LOGGER_FORMAT=console
LOGGER_OUTPUTPATH=

SWAGGER_ENABLED=true

APIKEYS_OPENAI=
APIKEYS_GEMINI=
APIKEYS_ANTHROPIC=
APIKEYS_VOYAGE=
APIKEYS_OPENROUTER=

LLM_DEFAULT_VENDOR=openai
LLM_EMBEDDING_PROVIDER=auto
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_DIM=0
LLM_LOCAL_URL=

CHAT_CACHE_TTL_SECONDS=300
CHAT_CACHE_MAX_ENTRIES=4096
