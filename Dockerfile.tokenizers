FROM golang:1.26.2-bookworm

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://github.com/daulet/tokenizers/releases/download/v1.27.0/libtokenizers.linux-amd64.tar.gz -o /tmp/libtokenizers.tar.gz \
    && tar -xzf /tmp/libtokenizers.tar.gz -C /usr/lib libtokenizers.a \
    && rm /tmp/libtokenizers.tar.gz

RUN go install github.com/air-verse/air@latest

COPY go.mod go.sum ./
RUN go mod download

ENV CGO_ENABLED=1

CMD ["air", "-c", ".air.tokenizers.toml"]
