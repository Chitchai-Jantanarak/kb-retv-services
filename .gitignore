!internal/application/intent/anchors.json

# Confidential: service keys and local secrets - never commit.
secrets/
*.pem
*.key

# Local Claude state.
.claude/

# Generated guard embedder asset - built outside Git.
assets/guard-embedder/

# Local generated/runtime outputs.
/api
/mailpoll
/worker
__pycache__/
*.pyc

train/*
migrator
scripts/*.sh
internal/**/probe_*_test.go
internal/**/*_live_test.go

